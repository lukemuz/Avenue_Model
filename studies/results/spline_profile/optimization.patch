+    #[test]
+    fn tweedie_half_power_deviance_matches_closed_form() {
+        // At p=1.5, d(y, mu) = 4 (sqrt(y) - sqrt(mu))^2 / sqrt(mu).
+        // Use this independent nonnegative expression across the fitting range.
+        for mu in [MU_FLOOR, 1e-200, 1e-20, 0.1, 1.0, 1e20, 1e200] {
+            for ratio in [0.0, 0.01, 0.5, 1.0, 2.0, 100.0] {
+                let y = mu * ratio;
+                let root_mu = mu.sqrt();
+                let difference = y.sqrt() - root_mu;
+                let expected = 4.0 * difference * (difference / root_mu);
+                let actual = LossFunction::Tweedie(1.5).unit_deviance(y, mu);
+                let scale = root_mu.max(expected.abs());
+                assert!(
+                    actual.is_finite() && (actual - expected).abs() <= 1e-13 * scale,
+                    "y={y}, mu={mu}: {actual} != {expected}"
+                );
+            }
+        }
+    }
